CREATE TABLE Event (
id INTEGER PRIMARY KEY AUTOINCREMENT,
user_id INTEGER NOT NULL REFERENCES User(id) ON DELETE CASCADE, -- NEW
venue_id INTEGER REFERENCES Venue(id) ON DELETE CASCADE,
name TEXT,
date TEXT,
game_type TEXT NOT NULL,
description TEXT,
created_at TEXT,
updated_at TEXT
);

getByVenue:
SELECT * FROM Event WHERE user_id = :userId AND venue_id = :venueId ORDER BY id DESC;

getAll:
SELECT * FROM Event WHERE user_id = :userId ORDER BY id DESC;

getUpcoming:
SELECT * FROM Event WHERE user_id = :userId AND date(date) >= date(:afterDate) ORDER BY date(date) ASC LIMIT :limit;

getUpcomingByVenue:
SELECT * FROM Event WHERE user_id = :userId AND date(date) >= date(:afterDate) AND venue_id = :id ORDER BY date(date) ASC LIMIT :limit;

getDay:
SELECT * FROM Event WHERE user_id = :userId AND date(date) == date(:day) ORDER BY date(date) ASC LIMIT :limit;

getDayByVenue:
SELECT * FROM Event WHERE user_id = :userId AND date(date) == date(:day) AND venue_id =:id ORDER BY date(date) ASC LIMIT :limit;

getRecent:
SELECT * FROM Event WHERE user_id = :userId AND date(date) <= date(:beforeDate) ORDER BY date(date) DESC LIMIT :limit;

getRecentByVenue:
SELECT * FROM Event WHERE user_id = :userId AND date(date) <= date(:beforeDate) AND venue_id =:id ORDER BY date(date) DESC LIMIT :limit;

insert:
INSERT INTO Event(
user_id, venue_id, name, date, game_type, description, created_at
) VALUES (?, ?, ?, ?, ?, ?, ?);

update:
UPDATE Event
SET
user_id = ?,
venue_id = ?,
name = ?,
date = ?,
game_type = ?,
description = ?,
updated_at = ?
WHERE id = ?;

getById:
SELECT * FROM Event WHERE user_id = :userId AND id = :eventId;

getByDate:
SELECT * FROM Event WHERE user_id = :userId AND date(date) = date(:date) ORDER BY time(date);

getEventDates:
SELECT DISTINCT date(date) AS event_date
FROM Event
WHERE user_id = :userId AND date(date);

deleteById:
DELETE FROM Event WHERE user_id = :userId AND id = :eventId;

deleteAllByUserId:
DELETE FROM Event WHERE user_id = :userId;

deleteAll:
DELETE FROM Event;

lastInsertRowId:
SELECT last_insert_rowid();
