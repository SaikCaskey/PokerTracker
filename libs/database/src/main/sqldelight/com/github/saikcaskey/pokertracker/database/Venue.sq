CREATE TABLE Venue (
id INTEGER PRIMARY KEY AUTOINCREMENT,
user_id INTEGER NOT NULL REFERENCES User(id) ON DELETE CASCADE, -- NEW
name TEXT NOT NULL,
address TEXT,
description TEXT,
created_at TEXT,
updated_at TEXT
);

getAll:
SELECT * FROM Venue WHERE user_id = :userId ORDER BY id DESC;

getRecent:
SELECT * FROM Venue WHERE user_id = :userId AND date(created_at) <= date(:beforeDate) ORDER BY created_at DESC LIMIT :limit;

insert:
INSERT INTO Venue(user_id, name, address, description, created_at)
VALUES (?, ?, ?, ?, ?);

update:
UPDATE Venue
SET
user_id = ?,
name = ?,
address = ?,
description = ?,
updated_at = ?
WHERE id = ?;

getById:
SELECT * FROM Venue WHERE user_id = :userId AND id = :venueId;

deleteAllByUserId:
DELETE FROM Venue WHERE user_id = :userId;

deleteAll:
DELETE FROM Venue;

deleteById:
DELETE FROM Venue WHERE user_id = :userId AND id = :id;

lastInsertRowId:
SELECT last_insert_rowid();
