CREATE TABLE Expense (
id INTEGER PRIMARY KEY AUTOINCREMENT,
user_id INTEGER NOT NULL REFERENCES User(id) ON DELETE CASCADE, -- NEW
event_id INTEGER REFERENCES Event(id) ON DELETE CASCADE,
venue_id INTEGER REFERENCES Venue(id) ON DELETE CASCADE,
type TEXT NOT NULL,
amount REAL NOT NULL,
description TEXT,
date TEXT,
created_at TEXT,
updated_at TEXT
);

getAll:
SELECT * FROM Expense WHERE user_id = :userId ORDER BY id DESC;

getRecent:
SELECT * FROM Expense WHERE user_id = :userId AND date(created_at) <= date(:beforeDate) ORDER BY date(created_at) DESC LIMIT :limit;

getUpcomingCosts:
SELECT
SUM(
CASE
WHEN type NOT IN ('CASH_OUT', 'DEAL') THEN -amount
ELSE 0
END
) AS balance
FROM Expense
WHERE user_id = :userId AND date(date) >= date(:afterDate);

getByEvent:
SELECT * FROM Expense WHERE user_id = :userId AND event_id = :eventId ORDER BY id;

insert:
INSERT INTO Expense(user_id, event_id, venue_id, type, amount, description, date, created_at)
VALUES (?, ?, ?, ?, ?,  ?,  ?,  ?);

update:
UPDATE Expense
SET
user_id = ?,
event_id = ?,
venue_id = ?,
amount = ?,
type = ?,
description = ?,
date = ?,
updated_at = ?
WHERE id = ?;

getById:
SELECT * FROM Expense WHERE user_id = :userId AND id = :expenseId;

deleteById:
DELETE FROM Expense WHERE user_id = :userId AND id = :id;

deleteAllByUserId:
DELETE FROM Expense WHERE user_id = :userId;

deleteAll:
DELETE FROM Expense;

getBalance:
SELECT
SUM(
CASE
WHEN type IN ('CASH_OUT', 'DEAL') THEN amount
ELSE -amount
END
) AS balance
FROM Expense
WHERE user_id = :userId AND date(date) BETWEEN :startDate AND :endDate;

getEventBalance:
SELECT
SUM(
CASE
WHEN type IN ('CASH_OUT', 'DEAL') THEN amount
ELSE -amount
END
) AS balance
FROM Expense
WHERE user_id = :userId AND event_id = :eventId;

getEventCostsSubtotal:
SELECT
SUM(
CASE
WHEN type NOT IN ('CASH_OUT', 'DEAL') THEN amount
END
) AS balance
FROM Expense
WHERE user_id = :userId AND event_id = :eventId;

getEventCashesSubtotal:
SELECT
SUM(
CASE
WHEN type IN ('CASH_OUT', 'DEAL') THEN amount
END
) AS balance
FROM Expense
WHERE user_id = :userId AND event_id = :eventId;

-- Cashes from all events at a venue
getVenueCashesSubtotal:
SELECT
SUM(
CASE
WHEN type IN ('CASH_OUT', 'DEAL') THEN amount
END
) AS balance
FROM Expense
JOIN Event ON Expense.event_id = Event.id
WHERE Event.user_id = :userId AND Event.venue_id = :venueId;

getVenueCostsSubtotal:
SELECT
SUM(
CASE
WHEN type NOT IN ('CASH_OUT', 'DEAL') THEN amount
END
) AS balance
FROM Expense
JOIN Event ON Expense.event_id = Event.id
WHERE Event.user_id = :userId AND Event.venue_id = :venueId;

getVenueBalance:
SELECT
SUM(
CASE
WHEN type IN ('CASH_OUT', 'DEAL') THEN amount
ELSE -amount
END
) AS balance
FROM Expense
JOIN Event ON Expense.event_id = Event.id
WHERE Event.user_id = :userId AND Event.venue_id = :venueId;

lastInsertRowId:
SELECT last_insert_rowid();
